<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para distinguir "el servidor no responde" de "este telefono no tiene
         internet" antes de ensenar el aviso de servidor caido. Es un permiso
         normal: no se le pregunta nada al usuario. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 en adelante exige pedir el permiso en tiempo de ejecucion.
         Sin el, las notificaciones no aparecen y la app pierde su razon de ser. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11 en adelante oculta que apps hay instaladas. Sin este bloque,
         resolveActivity() devuelve null aunque YouTube este instalado, y
         creeriamos que no lo esta. Declaramos solo los paquetes que abrimos. -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />   <!-- TikTok -->
        <package android:name="com.ss.android.ugc.trill" />   <!-- TikTok (otras regiones) -->
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />        <!-- X -->
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.instagram.barcelona" />    <!-- Threads -->
        <package android:name="org.telegram.messenger" />
        <package android:name="com.spotify.music" />
        <!-- Stickers: para saber si hay WhatsApp y preguntarle si ya tiene
             un paquete. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LeftVocesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nombre_app"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Relay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Relay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «Escribir al equipo», desde el menú del ícono: una ventanita para
             mandar un mensaje al chat sin entrar a la app. Va en su propia
             tarea (taskAffinity vacía) para que al cerrarse no se lleve la app
             si estaba abierta detrás, y no sale en recientes. No hace falta
             abrirla a otras apps: el atajo lo lanza el sistema en nombre de
             esta. -->
        <activity
            android:name=".atajos.EscribirAlEquipoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Relay.Ventana" />

        <service
            android:name=".notif.MensajeriaService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Stickers para WhatsApp. WhatsApp lee por aquí los paquetes que se
             le agregan desde la app (ver stickers/ProveedorDeStickers.kt).
             El permiso de lectura es de WhatsApp: solo él puede leerlo. -->
        <provider
            android:name=".stickers.ProveedorDeStickers"
            android:authorities="${applicationId}.stickers"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <!-- Para mandar un sticker suelto a Telegram, Signal, Messenger...
             Solo deja ver la carpeta de los stickers bajados. -->
        <provider
            android:name=".stickers.ArchivosDeStickers"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos_compartidos" />
        </provider>

        <!-- AdMob. El ID de la app sale de build.gradle.kts, uno por sabor. Sin
             esta línea la biblioteca de anuncios tumba la app al arrancar. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Que la biblioteca de anuncios no mida nada por su cuenta al
             arrancar. Solo empieza cuando la app la inicia, y la app solo la
             inicia para quien ve anuncios y después de preguntar por el
             consentimiento donde la ley lo pide (ver anuncios/Anuncios.kt). -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- Canal por defecto para cualquier aviso que llegue sin channelId -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="publicaciones" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ambar" />
    </application>
</manifest>

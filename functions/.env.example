# Copia este archivo como .env y llena los valores.
# Los SECRETOS no van aqui: se cargan con `firebase functions:secrets:set NOMBRE`.

# URL publica de la funcion websub. La sabras despues del primer despliegue:
#   firebase deploy --only functions:websub
# Copia la URL que imprime la terminal y pegala aqui, luego vuelve a desplegar.
PUBLIC_BASE_URL=https://websub-xxxxxxxxxx-uc.a.run.app

# Datos de Apple para "Sign in with Apple" y la revocacion de tokens.
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=XYZ9876543
APPLE_BUNDLE_ID=com.vocesdeizquierda.lefthub

# ---------------------------------------------------------------------------
# Secretos (NO se ponen en este archivo). Ejecuta uno por uno:
#
#   firebase functions:secrets:set YOUTUBE_API_KEY
#   firebase functions:secrets:set WEBSUB_SECRET          # cadena aleatoria larga
#   firebase functions:secrets:set WEBSUB_CALLBACK_TOKEN  # otra cadena aleatoria
#   firebase functions:secrets:set APPLE_PRIVATE_KEY      # contenido del .p8
#
# Para generar cadenas aleatorias:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

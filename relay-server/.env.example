# Copia como .env y rellena. docker compose lo lee solo.
# Para ejecutar sin Docker:  export $(grep -v '^#' .env | xargs)

# ---------------------------------------------------------------------------
# Base de datos (vive en tu VPS, no sale de ahi)
# ---------------------------------------------------------------------------
DB_NOMBRE=relay
DB_USUARIO=relay
DB_CLAVE=

# Solo si ejecutas el servidor fuera de Docker:
# DB_URL=jdbc:postgresql://localhost:5432/relay

# ---------------------------------------------------------------------------
# Secretos propios. Genera cada uno por separado con:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRETO=
WEBSUB_SECRETO=
WEBSUB_TOKEN_CALLBACK=
TOKEN_INTERNO=

# ---------------------------------------------------------------------------
# URL publica del servidor. El hub de Google la usa para entregar los avisos.
# En produccion, tu dominio con HTTPS. En desarrollo, la URL de ngrok.
# ---------------------------------------------------------------------------
RELAY_URL_PUBLICA=https://relay.tudominio.com

# Origen del panel de curaduria, separado por comas si hay varios.
CORS_ORIGENES=https://panel.tudominio.com

# ---------------------------------------------------------------------------
# Google (gratis, sin tarjeta)
# ---------------------------------------------------------------------------
# Clave de la YouTube Data API v3. 10.000 unidades diarias gratis.
YOUTUBE_API_KEY=

# client_id de tipo web. Se usa como audiencia al verificar los tokens que
# mandan las apps tras el inicio de sesion con Google.
GOOGLE_CLIENT_ID=

# FCM: unica via para entregar push a Android e iOS. Gratis e ilimitado.
FCM_PROYECTO_ID=
# Ruta EN EL HOST al JSON de la cuenta de servicio. docker-compose lo monta
# dentro del contenedor en /secretos/fcm.json
FCM_CREDENCIALES_HOST=/home/TU_USUARIO/.config/relay/fcm.json

# ---------------------------------------------------------------------------
# Apple. Solo si vas a publicar en la App Store. Dejalo vacio si no.
# ---------------------------------------------------------------------------
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del .p8 en una sola linea, con \n literales en los saltos.
APPLE_CLAVE_PRIVADA=

# Opcional. Clave de unavatar.io, de donde el panel toma las fotos de perfil
# de X, Instagram, TikTok... Sin clave da 25 fotos al dia, que suele sobrar.
FOTOS_API_KEY=

# Opcional. Clave de microlink.io, con el que el panel lee el nombre y la
# descripcion de una cuenta de X, Instagram, TikTok... para llenar la ficha.
# Sin clave da 25 consultas al dia.
PERFILES_API_KEY=

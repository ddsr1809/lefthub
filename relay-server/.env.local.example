PUERTO_HOST=8080
SERVIDOR_MEMORIA=640m
DB_MEMORIA=384m

DB_NOMBRE=relay_local
DB_USUARIO=relay
DB_CLAVE=

JWT_SECRETO=
WEBSUB_SECRETO=
WEBSUB_TOKEN_CALLBACK=
TOKEN_INTERNO=

# Llave que cifra los mensajes del chat con el equipo guardados en la base.
# Distinta en cada ambiente y NO va en el respaldo de la base: si se pierde,
# los mensajes ya no se pueden leer. Guarda una copia aparte.
#   echo "1:$(openssl rand -base64 32)"
# En el VPS la crea sola el primer despliegue (scripts/deploy-vps.sh); en
# local, ./local.sh. Para cambiarla sin perder lo anterior, agrega otra con
# el numero siguiente: 1:llave_vieja,2:llave_nueva. Vacio = sin chat.
CHAT_LLAVES=

# Llaves de los datos personales cifrados en la base (correo, IP, token de
# Apple, comprobantes de compra). OBLIGATORIAS: sin ellas el servidor no
# arranca. Como las del chat, distintas en cada ambiente y fuera de la base:
# si se pierden, esos datos ya no se pueden leer. Guarda una copia aparte.
# En el VPS las crea solas el despliegue (scripts/deploy-vps.sh); en local,
# ./local.sh.
#   DATOS_LLAVES: echo "1:$(openssl rand -base64 32)"  (se cambia como CHAT_LLAVES)
#   DATOS_INDICE: openssl rand -base64 32               (NO se cambia nunca)
DATOS_LLAVES=
DATOS_INDICE=
# Dias sin abrir la app tras los que se borra la IP de la cuenta. 0 = nunca.
DATOS_DIAS_IP=90

# Que solo la app original hable con la API (ver docs/wiki/seguridad.md,
# "Llave de la app"). Si se exige o solo se avisa se elige en el panel.
# APP_LLAVES: la llave de la firma, "1:BASE64". La crea sola deploy-vps.sh;
# la MISMA va en android/firma.properties (llave_app_pruebas o
# llave_app_produccion). Vacia = no se mira la firma.
APP_LLAVES=
# Numero del proyecto de Firebase (project_number de google-services.json),
# para comprobar App Check (Play Integrity). Vacio = no se mira.
APP_CHECK_PROYECTO=
# Opcional: IDs de app de Firebase aceptados (mobilesdk_app_id de
# google-services.json). Vacio = cualquier app del proyecto.
APP_CHECK_APPS=1:1025901070678:android:77a8355ef485c9794b6ef7

# Para probar recepcion WebSub usa aqui una URL HTTPS publica (por ejemplo,
# un tunel temporal). localhost sirve para probar la API desde tu equipo.
RELAY_URL_PUBLICA=http://localhost:8080
CORS_ORIGENES=http://localhost:5000,http://localhost:5173

YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=

FCM_PROYECTO_ID=
FCM_CREDENCIALES_HOST=/home/TU_USUARIO/.config/relay/fcm-local.json

APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLAVE_PRIVADA=

# Copia de creadores entre servidores. En local no se usa.
REPLICA_URL=
REPLICA_TOKEN=

# Opcional. Clave de unavatar.io, de donde el panel toma las fotos de perfil
# de X, Instagram, TikTok... Sin clave da 25 fotos al dia, que suele sobrar.
FOTOS_API_KEY=

# Opcional. Clave de microlink.io, con el que el panel lee el nombre y la
# descripcion de una cuenta de X, Instagram, TikTok... para llenar la ficha.
# Sin clave da 25 consultas al dia.
PERFILES_API_KEY=

# Opcional. Quitar los anuncios pagando en Google Play. Es el applicationId
# con el que la app esta en Play Console (com.vocesdeizquierda.lefthub en
# produccion). Vacio = la app no ofrece la compra; los folios de regalo
# funcionan igual. Antes de rellenarlo, la cuenta de servicio de FCM tiene que
# estar invitada en Play Console: ver "Anuncios" en el README.
COMPRAS_PAQUETE=
# El ID del producto de pago unico, como se dio de alta en Play Console.
COMPRAS_PRODUCTO=sin_anuncios

# Opcional. La version mas vieja de cada app que todavia se atiende, por
# ejemplo 1.0.1. Vacio = se atiende a todas. Con una minima puesta, la app que
# no llegue deja de funcionar y avisa de que hay que actualizarla. Las apps
# anteriores a la 1.0.1 no dicen que version son y cuentan como la mas vieja:
# cualquier minima las deja fuera. Ver "Versiones" en PIPELINE.md.
APP_VERSION_MINIMA_ANDROID=
APP_VERSION_MINIMA_IOS=

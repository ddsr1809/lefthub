PUERTO_HOST=8081
SERVIDOR_MEMORIA=640m
DB_MEMORIA=384m

DB_NOMBRE=relay_test
DB_USUARIO=relay
DB_CLAVE=

JWT_SECRETO=
WEBSUB_SECRETO=
WEBSUB_TOKEN_CALLBACK=
TOKEN_INTERNO=

RELAY_URL_PUBLICA=https://testapp.vocesdeizquierda.com
CORS_ORIGENES=https://testapp.vocesdeizquierda.com

YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=

FCM_PROYECTO_ID=
FCM_CREDENCIALES_HOST=/root/.config/vocesleft/fcm-test.json

APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLAVE_PRIVADA=

# Copia de creadores desde produccion. REPLICA_URL se queda vacio: testing
# solo recibe. REPLICA_TOKEN lo pone scripts/vps/replicar-creadores.sh, con el
# mismo valor que en .env.prod.
REPLICA_URL=
REPLICA_TOKEN=

# Opcional. Clave de unavatar.io, de donde el panel toma las fotos de perfil
# de X, Instagram, TikTok... Sin clave da 25 fotos al dia, que suele sobrar.
FOTOS_API_KEY=

# Opcional. Clave de microlink.io, con el que el panel lee el nombre y la
# descripcion de una cuenta de X, Instagram, TikTok... para llenar la ficha.
# Sin clave da 25 consultas al dia.
PERFILES_API_KEY=

# Opcional. Quitar los anuncios pagando en Google Play. Es el applicationId
# con el que la app esta en Play Console (com.vocesdeizquierda.lefthub en
# produccion). Vacio = la app no ofrece la compra; los folios de regalo
# funcionan igual. Antes de rellenarlo, la cuenta de servicio de FCM tiene que
# estar invitada en Play Console: ver "Anuncios" en el README.
COMPRAS_PAQUETE=
# El ID del producto de pago unico, como se dio de alta en Play Console.
COMPRAS_PRODUCTO=sin_anuncios
